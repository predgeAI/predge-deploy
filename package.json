{
  "name": "predge-deploy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "One-command multi-chain deploy of the Predge agent-settlement contract set (same bytecode, same addresses on every EVM chain).",
  "bin": { "predge-deploy": "./deploy.mjs" },
  "scripts": {
    "deploy": "node deploy.mjs",
    "keygen": "node scripts/keygen.mjs",
    "chains": "node scripts/probe-chains.mjs",
    "fork-all": "node scripts/fork-all.mjs",
    "funding": "node scripts/funding.mjs",
    "test": "node --test test/",
    "v2:test": "FOUNDRY_CONFIG=foundry-v2.toml forge test",
    "v2:coverage": "FOUNDRY_CONFIG=foundry-v2.toml forge coverage --no-match-coverage \"(test/|foundry-lib|contracts/[A-Za-z]+\\.sol)\"",
    "v2:fork": "node deploy.mjs --set v2 --fork --chain",
    "v2:mutate": "node scripts/mutate-v2.mjs",
    "v2:rsk-testnet:dry": "node deploy.mjs --set v2 --chain rootstock-testnet",
    "v2:rsk-testnet:deploy": "CONFIRM_TESTNET=rootstock-testnet node deploy.mjs --set v2 --chain rootstock-testnet --broadcast",
    "demo:job-escrow": "FOUNDRY_CONFIG=foundry-v2.toml forge build --threads 3 --silent && node demo/job-escrow/run.mjs",
    "demo:job-escrow:test": "FOUNDRY_CONFIG=foundry-v2.toml forge test --threads 3 --match-path test/foundry-v2/PredgeJobEscrow.t.sol && node --test test/job-escrow-verdict.test.mjs",
    "job-escrow:keygen": "node demo/job-escrow/cli.mjs keygen"
  },
  "engines": { "node": ">=20" },
  "dependencies": {
    "ethers": "6.13.4",
    "solc": "0.8.26"
  }
}
