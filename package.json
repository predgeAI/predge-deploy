    "fork-all": "node scripts/fork-all.mjs",
    "funding": "node scripts/funding.mjs",
    "test": "node --test test/"
  },
  "engines": { "node": ">=20" },
  "dependencies": {
    "ethers": "6.13.4",
    "solc": "0.8.26"
  }
}
